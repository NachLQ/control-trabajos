{
  "name": "control-trabajos",
  "version": "1.0.0",
  "description": "Control de Trabajos — MVP para técnicos y autónomos de servicios",
  "private": true,
  "scripts": {
    "install:all": "npm install && cd client && npm install && cd ../server && npm install",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\" --names \"SERVER,CLIENT\" --prefix-colors \"blue,green\"",
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "seed": "cd server && node db/seed.js",
    "generate-pdfs": "cd server && node scripts/generateSamplePdfs.js",
    "build": "cd client && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
